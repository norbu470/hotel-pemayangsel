<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Access Gateway | Hotel Pemayangsel</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0f2f5; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-card { background: white; padding: 2.5rem; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%; max-width: 400px; border-top: 4px solid #8B0000; }
        h2 { text-align: center; margin-bottom: 1.5rem; color: #222; }
        .error { color: #8B0000; background: #fbebeb; padding: 0.6rem; border-radius: 4px; text-align: center; font-size: 0.9rem; margin-bottom: 1rem; font-weight: bold; }
        .group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.2rem; }
        label { font-weight: bold; font-size: 0.9rem; }
        input { padding: 0.7rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
        .btn { background: #8B0000; color: white; border: none; padding: 0.8rem; border-radius: 4px; width: 100%; font-size: 1rem; font-weight: bold; cursor: pointer; }
        .btn:hover { background: #FF8C00; }
    </style>
</head>
<body>
    <div class="login-card">
        <h2>Admin Management Portal</h2>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form action="/admin/login" method="POST">
            <div class="group">
                <label>Admin Username</label>
                <input type="text" name="username" required placeholder="Enter admin username">
            </div>
            <div class="group">
                <label>Security Password</label>
                <input type="password" name="password" required placeholder="Enter password">
            </div>
            <button type="submit" class="btn">Login Securely</button>
        </form>
    </div>
</body>
</html>
