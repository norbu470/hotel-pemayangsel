<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dining & Bar | Hotel Pemayangsel</title>
    <style>
        :root {
            --primary-gold: #D4AF37;
            --deep-maroon: #8B0000;
            --warm-orange: #FF8C00;
            --dark-charcoal: #222222;
            --light-bg: #f9f9f9;
        }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0; padding: 0;
            line-height: 1.6; color: var(--dark-charcoal);
            background-color: var(--light-bg);
        }
        header {
            background-color: var(--dark-charcoal);
            border-bottom: 4px solid var(--warm-orange);
            padding: 1rem 2rem;
        }
        nav {
            display: flex; justify-content: space-between; align-items: center;
        }
        nav .logo a {
            color: white; font-size: 1.6rem; font-weight: bold; text-decoration: none;
            display: flex; align-items: center; gap: 0.8rem;
        }
        nav .logo span { color: var(--warm-orange); }
        nav ul { list-style: none; display: flex; margin: 0; padding: 0; }
        nav ul li { margin-left: 2rem; }
        nav ul li a {
            color: white; text-decoration: none; font-weight: 500; transition: 0.3s;
        }
        nav ul li a:hover { color: var(--primary-gold); }
        
        /* Photo Slide Carousel Rules */
        .slider-container {
            position: relative;
            max-width: 1000px;
            height: 450px;
            margin: 2rem auto;
            overflow: hidden;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
            background: #e0e0e0;
        }
        .dining-slide {
            position: absolute;
            width: 100%; height: 100%;
            opacity: 0;
            transition: opacity 0.8s ease-in-out;
        }
        .dining-slide.active { opacity: 1; }
        .dining-slide img { width: 100%; height: 100%; object-fit: cover; }
        .slider-btn {
            position: absolute;
            top: 50%; transform: translateY(-50%);
            background: rgba(0, 0, 0, 0.6);
            color: white; border: none;
            padding: 1rem; cursor: pointer;
            font-size: 1.2rem; z-index: 10;
            border-radius: 4px;
        }
        .prev-btn { left: 10px; }
        .next-btn { right: 10px; }

        .container { max-width: 1200px; margin: 3rem auto; padding: 0 2rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
        .card {
            background: white; border-radius: 8px; overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-top: 3px solid var(--deep-maroon);
        }
        .card-img { width: 100%; height: 250px; object-fit: cover; }
        .card-content { padding: 1.5rem; }
        footer {
            background: var(--dark-charcoal); color: white; text-align: center;
            padding: 1.5rem; margin-top: 5rem;
        }
    </style>
</head>
<body>

    <header>
        <nav>
            <div class="logo">
                <a href="/">
                    <img src="/images/logo.png" alt="Hotel Pemayangsel Logo" style="height:40px;">
                    <span>Hotel Pemayangsel★★★</span>
                </a>
            </div>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/rooms">Rooms</a></li>
                <li><a href="/dining">Dining & Bar</a></li>
                <li><a href="/contact">Book Now</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        <h1 style="text-align: center; margin-bottom: 1rem;">Dining & Entertainment</h1>
        <p style="text-align: center; color: #666; margin-bottom: 2rem;">Explore culinary excellence at The Rice Field Restaurant and premium spirits at The Dragon's Nest Bar.</p>
        
        <!-- Dining Photo Slider Carousel -->
        <div class="slider-container">
            <button class="slider-btn prev-btn" onclick="moveDiningSlide(-1)">&#10094;</button>
            
            <!-- Slide 1: Local Image -->
            <div class="dining-slide active">
                <img src="/images/food1.png" alt="Traditional Bhutanese Food Platter">
            </div>
            
            <!-- Slide 2: Local Image -->
            <div class="dining-slide">
                <img src="/images/food2.jpg" alt="Continental Buffet Dinner Setup">
            </div>
	    <div class="dining-slide">
                <img src="/images/food3.jpg" alt="Continental Buffet Dinner Setup">
            </div>
	    <div class="dining-slide">
                <img src="/images/food4.jpg" alt="Continental Buffet Dinner Setup">
            </div>

            
            <!-- Slide 3: Local Image -->
            <div class="dining-slide">
                <img src="/images/bar.jpg" alt="The Dragon's Nest Bar Area">
            </div>

            <button class="slider-btn next-btn" onclick="moveDiningSlide(1)">&#10095;</button>
        </div>

        <!-- Restaurant Section Layout Content -->
        <section style="margin-bottom: 4rem; margin-top: 3rem;">
            <h2>🍽️ The Rice Field Restaurant</h2>
            <p>Open daily from 7:00 AM to 10:00 PM for fine buffet dining selections.</p>
            <div class="grid" style="margin-top: 1.5rem;">
                <div class="card" style="border-top-color: #FF8C00;">
                    <!-- Local Image -->
                    <img src="/images/food1.png" alt="Traditional Platter" class="card-img">
                    <div class="card-content">
                        <h4>Bhutanese Traditional Platter</h4>
                        <p>Nutritious local red rice served with authentic Ema Datshi (chili and cheese stew), seasoned Kewa Datshi, and a curated assortment of mountain-herbed vegetable stews.</p>
                    </div>
                </div>
                <div class="card" style="border-top-color: #FF8C00;">
                    <!-- Local Image -->
                    <img src="/images/food2.jpg" alt="Continental Buffet" class="card-img">
                    <div class="card-content">
                        <h4>Continental & Indian Favorites</h4>
                        <p>A broad array of freshly prepared items including baked pastries, customized pasta noodles, subcontinental curries, and river trout delicacies grilled by our head chef.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Bar Section Layout Content -->
        <section style="margin-bottom: 3rem;">
            <h2>🍸 The Dragon's Nest Bar</h2>
            <p>Unwind in a cozy musical setting. Open daily from 2:00 PM until midnight.</p>
            <div class="grid" style="margin-top: 1.5rem;">
                <div class="card" style="border-top-color: #D4AF37;">
                    <!-- Local Image -->
                    <img src="/images/bar.png" alt="Bar Area" class="card-img">
                    <div class="card-content">
                        <h4>Local Craft Beers & Spirits</h4>
                        <p>Unwind against our hand-polished wooden bar counter layout. Taste award-winning local favorites like Druk 11000 beer, premium K5 Whiskey, Zumzin wine, or house-brewed warm Ara.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Hotel Pemayangsel. All Rights Reserved.</p>
    </footer>

    <!-- JavaScript Slide Animation Engine for Dining -->
    <script>
        let currentDiningSlideIndex = 0;
        const diningSlides = document.querySelectorAll('.dining-slide');

        // Explicit initialization layout check to clear system caching offsets
        function initDiningSlider() {
            diningSlides.forEach((slide, idx) => {
                if(idx === 0) slide.classList.add('active');
                else slide.classList.remove('active');
            });
        }

        function showDiningSlide(index) {
            diningSlides[currentDiningSlideIndex].classList.remove('active');
            currentDiningSlideIndex = (index + diningSlides.length) % diningSlides.length;
            diningSlides[currentDiningSlideIndex].classList.add('active');
        }

        function moveDiningSlide(step) {
            showDiningSlide(currentDiningSlideIndex + step);
        }

        // Auto Advance Slide every 4.5 seconds
        setInterval(() => {
            moveDiningSlide(1);
        }, 4500);

        window.onload = initDiningSlider;
    </script>

</body>
</html>
